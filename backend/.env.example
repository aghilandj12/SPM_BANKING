# Copy to backend/.env and fill in. Never commit the real .env.

# Server
PORT=3001

# MongoDB Atlas connection string (database: SPM_banking_application)
# URL-encode special characters in the password, e.g. "@" -> %40
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SPM_banking_application?retryWrites=true&w=majority
# Same link, used by scripts/addManager.js and scripts/migrateDB.js
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/SPM_banking_application?retryWrites=true&w=majority

# Auth - at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=8h

# CORS - the frontend origin(s) allowed to call the API (comma-separated)
FRONTEND_URL=http://localhost:5173

# Google Gemini - fallback model after Groq (tried in order 1 -> 2 -> 3 -> GEMINI_API_KEY)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY=

# Groq - primary model (optional but recommended)
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=openai/gpt-oss-120b

# FX - converts USD exposures to INR
FX_USD_INR=88

# Optional AI time budgets in milliseconds
# AI_TOTAL_BUDGET_MS=80000
# EXTRACTION_TOTAL_BUDGET_MS=110000
